<?xml version="1.0" encoding="utf-8"?>
<!--
  Cold-start splash icon: the aLink chevron mark, deliberately NOT the wordmark.
  Drawn on the 288dp splash canvas with the mark kept inside the 192dp inner circle the platform
  masks to, so it renders identically on the API 31+ system splash and the compat splash.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00B4D8"
        android:strokeWidth="26"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M112,86 L176,144 L112,202" />
</vector>
